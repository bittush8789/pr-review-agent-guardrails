# GitHub PR-Review Agent with Guardrails Configuration Template
# Copy this file to .env for local testing or set these as GitHub Actions Secrets / Environment variables.
# NEVER commit files containing real credentials.

# Google Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=replace_with_your_api_key

# Supported Gemini Model Identifier (e.g., gemini-3.8-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-3.8-flash

# GitHub Integration
# Required permissions: contents:read, pull-requests:write
GITHUB_TOKEN=replace_with_github_token
GITHUB_REPOSITORY=owner/repository
PULL_REQUEST_NUMBER=1

# Review Guardrail Limits
MAX_COMMENTS_PER_PR=5
CONFIDENCE_THRESHOLD=0.70

# Execution Controls
# Set to 'true' to run analysis without posting inline comments to GitHub
DRY_RUN=false
LOG_LEVEL=INFO

# Networking & Timeouts
GITHUB_API_URL=https://api.github.com
REQUEST_TIMEOUT_SECONDS=30

# LangSmith Observability & Tracing (Optional)
# Get your API key from https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=replace_with_your_langsmith_api_key
LANGCHAIN_PROJECT=github-pr-review-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
